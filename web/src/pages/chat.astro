---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResumeFingerprint from '../components/ResumeFingerprint.jsx';
import FloatingChatBubble from '../components/FloatingChatBubble.jsx';
---
<BaseLayout title="Chat & Resume Fingerprint | ResAnalyze" description="Chat with the NLP AI Assistant and view your unique Resume Fingerprint vector graphic.">
  <main class="container mx-auto px-4 py-28 min-h-screen relative z-10 space-y-16">
    <div class="mx-auto max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">
        AI Chat & <span class="gradient-text">Resume Fingerprints</span>
      </h1>
      <p class="text-white/60 max-w-xl mx-auto text-sm md:text-base font-light">
        Consult with the MCP-backed AI assistant and generate custom social-shareable vector fingerprints of your resume.
      </p>
    </div>

    <div class="grid md:grid-cols-5 gap-8 max-w-6xl mx-auto items-start">
      {/* Fingerprint Card */}
      <div class="md:col-span-2 text-left">
        <ResumeFingerprint client:only="react" />
      </div>

      {/* Chat Workspace */}
      <div class="md:col-span-3 text-left">
        <div class="glass-card border border-white/5 h-[480px] flex flex-col justify-between overflow-hidden">
          <div class="flex items-center gap-2 border-b border-white/5 pb-4 mb-4">
            <span class="h-2.5 w-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
            <span class="font-bold text-sm text-white">Full-Screen Workspace Assistant</span>
          </div>

          <div class="flex-1 overflow-y-auto px-2 py-2 space-y-4 text-xs">
            <div class="flex justify-start">
              <div class="max-w-[85%] rounded-2xl bg-white/5 border border-white/5 px-4 py-3 leading-relaxed text-white/90">
                Welcome to the full developer chat space! I can help you write customized STAR bullets, translate your resume vectors into alternate roles, or check for specific ATS keyword compliance patterns. Ask me anything.
              </div>
            </div>
            <div class="flex justify-end">
              <div class="max-w-[85%] rounded-2xl bg-violet-600 px-4 py-3 leading-relaxed text-white">
                How is my semantic skills vector computed?
              </div>
            </div>
            <div class="flex justify-start">
              <div class="max-w-[85%] rounded-2xl bg-white/5 border border-white/5 px-4 py-3 leading-relaxed text-white/90">
                We take your extracted skills (e.g. Python, NLP, PyTorch) and run them through a Sentence-Transformer model (dimension: 384). This generates a dense mathematical vector. We then calculate the cosine similarity between your resume vector and the target job description vector. High cosine alignment results in a higher ATS score.
              </div>
            </div>
          </div>

          <div className="flex gap-2 p-2 border-t border-white/5 bg-black/25 mt-4">
            <input
              type="text"
              placeholder="Message workspace assistant..."
              className="flex-1 rounded-xl bg-white/5 px-4 py-2 text-xs text-white placeholder-white/30 border border-white/10 focus:outline-none focus:border-cyan-500/50"
            />
            <button
              type="button"
              className="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-r from-violet-600 to-cyan-500 text-white cursor-pointer hover:scale-105 transition-transform"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" strokeWidth="2.5"><path d="M1 8h14M9 2l6 6-6 6"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
